{
  "name": "@coderlifenet/form-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/migrate.js",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@coderlifenet/form-core": "0.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
