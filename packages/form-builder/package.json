{
  "name": "@coderlifenet/form-builder",
  "version": "0.1.0-alpha.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoderLifeNet/form-builder.git",
    "directory": "packages/form-builder"
  },
  "bugs": {
    "url": "https://github.com/CoderLifeNet/form-builder/issues"
  },
  "homepage": "https://github.com/CoderLifeNet/form-builder/tree/main/packages/form-builder",
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "builder": [
        "dist/index.d.ts"
      ],
      "renderer": [
        "dist/renderer/index.d.ts"
      ],
      "core": [
        "dist/core/index.d.ts"
      ],
      "server": [
        "dist/server/index.d.ts"
      ],
      "postgres": [
        "dist/postgres/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "npm run build -w @coderlifenet/form-core && npm run build -w @coderlifenet/form-postgres && npm run build -w @coderlifenet/form-server && npm run build -w @coderlifenet/form-react && tsc -p tsconfig.json && node scripts/prepare-public-artifact.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "morgan": "1.12.1",
    "nanoid": "5.1.16",
    "pg": "8.16.3",
    "re2js": "1.2.0",
    "zod": "4.1.11"
  },
  "peerDependencies": {
    "@coderlifenet/ui-core": "0.2.0-alpha.0",
    "@coderlifenet/ui-components": "0.2.0-alpha.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/morgan": "1.9.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ]
}
