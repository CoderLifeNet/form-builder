# Service
PORT=4010
FORM_DB_URL=postgres://formbuilder:formbuilder@localhost:55432/formbuilder
FORM_UPLOAD_PROVIDER=filesystem
FORM_UPLOAD_DIR=.form_uploads/private

# Optional S3-compatible upload provider
# FORM_UPLOAD_PROVIDER=s3
# FORM_S3_BUCKET=form-builder-dev
# FORM_S3_REGION=us-east-1
# FORM_S3_ENDPOINT=http://localhost:3900
# FORM_S3_ACCESS_KEY=<access-key>
# FORM_S3_SECRET_KEY=<secret-key>
# FORM_S3_FORCE_PATH_STYLE=true

# Development auth toggles (disabled by default)
# FORM_DEV_AUTH=true
# FORM_DEV_ALLOW_HEADER_CONTEXT=true
# FORM_ALLOW_ANON_SUBMIT=true

# Example host demo identities (development only)
DEMO_USERS=owner1,collab1,outsider1
